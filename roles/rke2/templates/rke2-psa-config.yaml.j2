# Deployed by Ansible.
# Do not edit manually, changes will be overwritten.

apiVersion: apiserver.config.k8s.io/v1
kind: AdmissionConfiguration
plugins:
  - name: PodSecurity
    configuration:
      apiVersion: pod-security.admission.config.k8s.io/v1beta1
      kind: PodSecurityConfiguration
      defaults:
        enforce: "restricted"
        enforce-version: "{{ rke2_psa_enforce_version }}"
        audit: "restricted"
        audit-version: "latest"
        warn: "restricted"
        warn-version: "latest"
      exemptions:
        usernames: []
        runtimeClasses: []
        # Namespaces that need privileged pods label themselves instead
        # (cilium-system, istio-system in k8s-fleet).
        namespaces:
          - kube-system
