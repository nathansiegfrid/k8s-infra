# Deployed by Ansible.
# Do not edit manually, changes will be overwritten.
#
# https://docs.rke2.io/install/configuration

profile: cis

node-name: {{ inventory_hostname }}
node-ip: {{ node_private_ip }}

{% if rke2_type == 'server' %}
token: {{ rke2_server_token | to_json }}
agent-token: {{ rke2_agent_token | default(rke2_server_token, true) | to_json }}
{% else %}
token: {{ rke2_agent_token | default(rke2_server_token, true) | to_json }}
{% endif %}

{% if inventory_hostname != rke2_first_server %}
server: https://{{ hostvars[rke2_first_server].node_private_ip }}:9345
{% endif %}

{% if rke2_type == 'server' %}
bind-address: {{ node_private_ip }}
advertise-address: {{ node_private_ip }}

tls-san:
{% for host in rke2_servers %}
  - {{ host }}
  - {{ hostvars[host].node_private_ip }}
{% endfor %}

cni: {{ rke2_cni }}
cluster-cidr: {{ rke2_cluster_cidr }}
service-cidr: {{ rke2_service_cidr }}
cluster-dns: {{ rke2_cluster_dns }}

ingress-controller: {{ rke2_ingress_controller }}

disable-kube-proxy: {{ rke2_disable_kube_proxy | lower }}
{% if rke2_disable_components | length > 0 %}
disable:
{% for component in rke2_disable_components %}
  - {{ component }}
{% endfor %}
{% endif %}

write-kubeconfig-mode: "0600"

kube-apiserver-arg:
  # Auth
  - anonymous-auth=false
  - service-account-extend-token-expiration=false

  # TLS
  - tls-min-version=VersionTLS12

  # Admission Control
  - admission-control-config-file={{ rke2_config_dir }}/rke2-psa-config.yaml

  # Audit Logging
  - audit-policy-file={{ rke2_config_dir }}/audit-policy.yaml
  - audit-log-path=/var/log/kubernetes/audit.log
  - audit-log-maxage=30
  - audit-log-maxbackup=10
  - audit-log-maxsize=100

node-taint:
  # RKE2 components explicitly tolerate NoSchedule.
  - node-role.kubernetes.io/control-plane:NoSchedule

etcd-snapshot-schedule-cron: {{ rke2_etcd_snapshot_schedule_cron | to_json }}
etcd-snapshot-retention: {{ rke2_etcd_snapshot_retention | int }}

{% if rke2_etcd_s3 %}
etcd-s3: true
etcd-s3-bucket: {{ rke2_etcd_s3_bucket | to_json }}
etcd-s3-region: {{ rke2_etcd_s3_region | to_json }}
etcd-s3-endpoint: {{ rke2_etcd_s3_endpoint | to_json }}
etcd-s3-access-key: {{ rke2_etcd_s3_access_key | to_json }}
etcd-s3-secret-key: {{ rke2_etcd_s3_secret_key | to_json }}
etcd-s3-retention: {{ rke2_etcd_s3_retention | int }}
{% endif %}
{% endif %}
