# Secrets Flux can't get from git: the key to read k8s-fleet, and the key
# to decrypt k8s-fleet's secrets.
apiVersion: v1
kind: Secret
metadata:
  name: flux-system
  namespace: flux-system
type: Opaque
stringData:
  identity: {{ flux_git_deploy_key | to_json }}
  known_hosts: {{ flux_bootstrap_known_hosts | to_json }}

---
apiVersion: v1
kind: Secret
metadata:
  name: sops-age
  namespace: flux-system
type: Opaque
stringData:
  age.agekey: {{ flux_sops_age_key | to_json }}
