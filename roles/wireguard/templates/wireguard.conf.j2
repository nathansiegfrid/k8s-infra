# Deployed by Ansible.
# Do not edit manually, changes will be overwritten.

[Interface]
Address = {{ node_private_ip }}/24
ListenPort = {{ wireguard_port }}
MTU = {{ wireguard_mtu }}

# The private key stays in its own file on this node.
PreUp = wg set %i private-key {{ wireguard_dir }}/private.key

PostUp = /usr/sbin/iptables -A FORWARD -i %i -j ACCEPT; /usr/sbin/iptables -A FORWARD -o %i -j ACCEPT
PostDown = /usr/sbin/iptables -D FORWARD -i %i -j ACCEPT; /usr/sbin/iptables -D FORWARD -o %i -j ACCEPT

{% for host in groups['k8s_nodes'] %}
{% if host != inventory_hostname %}
# {{ host }}
[Peer]
PublicKey = {{ hostvars[host].wireguard_public_key }}
Endpoint = {{ hostvars[host].node_public_ip }}:{{ wireguard_port }}
AllowedIPs = {{ hostvars[host].node_private_ip }}/32
PersistentKeepalive = {{ wireguard_persistent_keepalive }}

{% endif %}
{% endfor %}
{% for peer in wireguard_extra_peers %}
# {{ peer.name }}
[Peer]
PublicKey = {{ peer.public_key }}
AllowedIPs = {{ peer.allowed_ips }}

{% endfor %}
