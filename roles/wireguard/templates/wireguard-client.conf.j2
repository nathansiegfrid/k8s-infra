# Generated by Ansible for {{ item.name }}.
{% if item.private_key is defined %}
# Holds this machine's private key, from wireguard_extra_peers.
{% else %}
# Add this machine's private key below, or set private_key for this peer in
# wireguard_extra_peers to have it filled in.
{% endif %}
# PersistentKeepalive stops a NAT in front of this machine from closing the
# tunnel while a long task is quiet.

[Interface]
PrivateKey = {{ item.private_key | default('<REPLACE_WITH_PRIVATE_KEY>') }}
Address = {{ item.allowed_ips.split('/')[0] }}/24

{% for host in groups['k8s_nodes'] %}
# {{ host }}
[Peer]
PublicKey = {{ hostvars[host].wireguard_public_key }}
Endpoint = {{ hostvars[host].node_public_ip }}:{{ wireguard_port }}
AllowedIPs = {{ hostvars[host].node_private_ip }}/32
PersistentKeepalive = {{ item.persistent_keepalive | default(wireguard_persistent_keepalive) }}

{% endfor %}
