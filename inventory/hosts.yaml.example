---
# Copy to hosts.yaml (git-ignored) and fill in the real IPs.
#
#   node_public_ip:  the provider's address, used until WireGuard is up
#   node_private_ip: the node's WireGuard address
#
# Every other var lives in group_vars.

k8s_nodes:
  children:
    k8s_master_nodes:
    k8s_worker_nodes:

# Keep the masters' WireGuard IPs in 10.0.0.0/29 (10.0.0.1 to 10.0.0.7).
# k8s-fleet's host firewall lets only that range reach etcd.
k8s_master_nodes:
  hosts:
    # The first master bootstraps the cluster, and etcd restores run on it.
    k8s-master-01:
      node_public_ip: <PUBLIC_IP>
      node_private_ip: 10.0.0.1
    k8s-master-02:
      node_public_ip: <PUBLIC_IP>
      node_private_ip: 10.0.0.2
    k8s-master-03:
      node_public_ip: <PUBLIC_IP>
      node_private_ip: 10.0.0.3

k8s_worker_nodes:
  hosts:
    k8s-worker-01:
      node_public_ip: <PUBLIC_IP>
      node_private_ip: 10.0.0.11
    k8s-worker-02:
      node_public_ip: <PUBLIC_IP>
      node_private_ip: 10.0.0.12
    k8s-worker-03:
      node_public_ip: <PUBLIC_IP>
      node_private_ip: 10.0.0.13
